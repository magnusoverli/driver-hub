{
  "schema": "driver-config-values",
  "description": "Effective values checked against schemaVersion 2 (proposed) declarations, as Driver Hub must check every value before deployment or token reservation, whether the operator, a site profile or a default supplied it. Each case names an input, a value and the reason codes it must produce, as a set; [] means accepted. Inputs are named after nothing in particular: the same rules apply whatever an input is called. Secret inputs are never checked, so none appear here. Run: python3 tools/validate-driver.py fixtures",
  "reasons": {
    "wrong_type": "the value is not of the input's type",
    "too_short": "shorter than minLength (Unicode code points)",
    "too_long": "longer than maxLength (Unicode code points)",
    "below_minimum": "an integer below minimum",
    "above_maximum": "an integer above maximum",
    "not_in_enum": "not exactly one of enum (case-sensitive)",
    "url_invalid": "not an absolute URL in canonical form; no other url_ code is reported",
    "url_scheme": "the scheme, compared case-insensitively, is not in schemes",
    "url_credentials": "the authority has userinfo (an @, even with nothing before it) and allowCredentials is false",
    "url_path": "the path differs from path, character for character; an empty path is not /",
    "url_query": "the value has ? (even with an empty query) and allowQuery is false",
    "url_fragment": "the value has # (even with an empty fragment) and allowFragment is false"
  },
  "inputs": {
    "backendUrl": {"type": "string", "required": true, "env": "BACKEND_URL",
                   "url": {"schemes": ["wss"], "path": "/x-driver/v1", "allowCredentials": false, "allowQuery": false, "allowFragment": false}},
    "deviceControlUrl": {"type": "string", "required": true, "env": "DEVICE_CONTROL_URL",
                         "url": {"schemes": ["ws"], "allowCredentials": true, "allowQuery": true, "allowFragment": false}},
    "dualSchemeUrl": {"type": "string", "required": false, "default": "wss://device.example.test/api", "env": "DEVICE_API_URL",
                      "url": {"schemes": ["ws", "wss"], "path": "/api", "allowCredentials": false, "allowQuery": false, "allowFragment": false}},
    "shortUrl": {"type": "string", "required": true, "minLength": 1, "maxLength": 24, "env": "SHORT_URL",
                 "url": {"schemes": ["https"], "allowCredentials": false, "allowQuery": false, "allowFragment": false}},
    "logLevel": {"type": "string", "required": false, "default": "info", "env": "LOG_LEVEL",
                 "enum": ["trace", "debug", "info", "warn", "error"]},
    "requestLimit": {"type": "integer", "required": false, "default": 16, "minimum": 1, "maximum": 256, "env": "REQUEST_LIMIT"}
  },
  "cases": [
    {"input": "backendUrl", "value": "wss://vip.example.test/x-driver/v1", "errors": []},
    {"input": "backendUrl", "value": "WSS://VIP.Example.Test/x-driver/v1", "errors": [], "note": "scheme is case-insensitive; the host is not checked against anything"},
    {"input": "backendUrl", "value": "wss://vip.example.test:8443/x-driver/v1", "errors": [], "note": "explicit port"},
    {"input": "backendUrl", "value": "wss://vip.example.test:443/x-driver/v1", "errors": [], "note": "explicit default port"},
    {"input": "backendUrl", "value": "wss://[2001:db8::1]:8443/x-driver/v1", "errors": [], "note": "IPv6 literal"},
    {"input": "backendUrl", "value": "wss://192.0.2.10/x-driver/v1", "errors": [], "note": "IPv4 literal"},
    {"input": "backendUrl", "value": "wss://vip.example.test./x-driver/v1", "errors": [], "note": "fully qualified name"},
    {"input": "backendUrl", "value": "wss://vip_1~a/x-driver/v1", "errors": [], "note": "every host character"},

    {"input": "backendUrl", "value": "ws://vip.example.test/x-driver/v1", "errors": ["url_scheme"], "note": "the v0.3.0 incident"},
    {"input": "backendUrl", "value": "https://vip.example.test/x-driver/v1", "errors": ["url_scheme"]},
    {"input": "backendUrl", "value": "wss://vip.example.test/x-driver/v1/", "errors": ["url_path"], "note": "trailing slash"},
    {"input": "backendUrl", "value": "wss://vip.example.test/X-Driver/v1", "errors": ["url_path"], "note": "paths are case-sensitive"},
    {"input": "backendUrl", "value": "wss://vip.example.test/x-driver/v2", "errors": ["url_path"]},
    {"input": "backendUrl", "value": "wss://vip.example.test", "errors": ["url_path"], "note": "empty path"},
    {"input": "backendUrl", "value": "wss://vip.example.test/", "errors": ["url_path"]},
    {"input": "backendUrl", "value": "wss://vip.example.test/x-driver/./v1", "errors": ["url_path"], "note": "dot segments are not resolved"},
    {"input": "backendUrl", "value": "wss://vip.example.test/x-driver/%2e/v1", "errors": ["url_path"], "note": "encoded dot segment"},
    {"input": "backendUrl", "value": "wss://vip.example.test/x-driver/v%31", "errors": ["url_path"], "note": "escapes are not decoded"},
    {"input": "backendUrl", "value": "wss://user:secret@vip.example.test/x-driver/v1", "errors": ["url_credentials"]},
    {"input": "backendUrl", "value": "wss://user@vip.example.test/x-driver/v1", "errors": ["url_credentials"]},
    {"input": "backendUrl", "value": "wss://@vip.example.test/x-driver/v1", "errors": ["url_credentials"], "note": "an empty userinfo still counts"},
    {"input": "backendUrl", "value": "wss://vip.example.test/x-driver/v1?", "errors": ["url_query"], "note": "empty query"},
    {"input": "backendUrl", "value": "wss://vip.example.test/x-driver/v1?node_id=afe3cf0d-d906-4a89-a495-5f6a989a16c1", "errors": ["url_query"], "note": "the driver adds node_id itself"},
    {"input": "backendUrl", "value": "wss://vip.example.test/x-driver/v1#", "errors": ["url_fragment"], "note": "empty fragment"},
    {"input": "backendUrl", "value": "wss://vip.example.test/x-driver/v1#top", "errors": ["url_fragment"]},
    {"input": "backendUrl", "value": "ws://u:p@vip.example.test/x?q#f", "errors": ["url_credentials", "url_fragment", "url_path", "url_query", "url_scheme"], "note": "every reason at once"},
    {"input": "backendUrl", "value": "", "errors": ["url_invalid"]},
    {"input": "backendUrl", "value": "vip.example.test/x-driver/v1", "errors": ["url_invalid"], "note": "no scheme"},
    {"input": "backendUrl", "value": "wss:/vip.example.test/x-driver/v1", "errors": ["url_invalid"], "note": "one slash: WHATWG parsers repair it, so it is not canonical"},
    {"input": "backendUrl", "value": "wss:\\\\vip.example.test\\x-driver\\v1", "errors": ["url_invalid"], "note": "backslashes"},
    {"input": "backendUrl", "value": " wss://vip.example.test/x-driver/v1", "errors": ["url_invalid"], "note": "leading space"},
    {"input": "backendUrl", "value": "wss://vip.example.test/x-driver/v1\n", "errors": ["url_invalid"], "note": "trailing newline"},
    {"input": "backendUrl", "value": "wss:///x-driver/v1", "errors": ["url_invalid"], "note": "no host"},
    {"input": "backendUrl", "value": "wss://vip.example.test:/x-driver/v1", "errors": ["url_invalid"], "note": "empty port"},
    {"input": "backendUrl", "value": "wss://vip.example.test:65536/x-driver/v1", "errors": ["url_invalid"], "note": "port out of range"},
    {"input": "backendUrl", "value": "wss://192.0.2.256/x-driver/v1", "errors": ["url_invalid"], "note": "invalid IPv4"},
    {"input": "backendUrl", "value": "wss://3221225994/x-driver/v1", "errors": ["url_invalid"], "note": "numeric host: only dotted-quad IPv4 is canonical"},
    {"input": "backendUrl", "value": "wss://[2001:db8::g]/x-driver/v1", "errors": ["url_invalid"], "note": "invalid IPv6"},
    {"input": "backendUrl", "value": "wss://[fe80::1%25eth0]/x-driver/v1", "errors": ["url_invalid"], "note": "IPv6 zone"},
    {"input": "backendUrl", "value": "wss://vïp.example.test/x-driver/v1", "errors": ["url_invalid"], "note": "non-ASCII: enter internationalized names as xn-- labels"},
    {"input": "backendUrl", "value": 443, "errors": ["wrong_type"]},

    {"input": "deviceControlUrl", "value": "ws://192.0.2.20/control?unit=1", "errors": [], "note": "query allowed for this input"},
    {"input": "deviceControlUrl", "value": "ws://admin@192.0.2.20/", "errors": [], "note": "credentials allowed for this input"},
    {"input": "deviceControlUrl", "value": "ws://192.0.2.20", "errors": [], "note": "no declared path: any path"},
    {"input": "deviceControlUrl", "value": "wss://192.0.2.20/control", "errors": ["url_scheme"], "note": "the opposite policy to backendUrl"},
    {"input": "deviceControlUrl", "value": "ws://192.0.2.20/control#x", "errors": ["url_fragment"]},

    {"input": "dualSchemeUrl", "value": "ws://device.example.test/api", "errors": []},
    {"input": "dualSchemeUrl", "value": "wss://device.example.test/api", "errors": []},
    {"input": "dualSchemeUrl", "value": "http://device.example.test/api", "errors": ["url_scheme"]},
    {"input": "dualSchemeUrl", "value": "wss://device.example.test/api/", "errors": ["url_path"]},

    {"input": "shortUrl", "value": "https://a.example.test/x", "errors": [], "note": "24 characters"},
    {"input": "shortUrl", "value": "https://ab.example.test/x", "errors": ["too_long"]},
    {"input": "shortUrl", "value": "", "errors": ["too_short", "url_invalid"], "note": "length and url rules both apply"},
    {"input": "shortUrl", "value": "http://a.example.test/x", "errors": ["url_scheme"]},

    {"input": "logLevel", "value": "trace", "errors": []},
    {"input": "logLevel", "value": "error", "errors": []},
    {"input": "logLevel", "value": "INFO", "errors": ["not_in_enum"], "note": "case-sensitive"},
    {"input": "logLevel", "value": "warning", "errors": ["not_in_enum"]},
    {"input": "logLevel", "value": " info", "errors": ["not_in_enum"], "note": "not trimmed"},
    {"input": "logLevel", "value": "", "errors": ["not_in_enum"]},
    {"input": "logLevel", "value": true, "errors": ["wrong_type"]},

    {"input": "requestLimit", "value": 1, "errors": []},
    {"input": "requestLimit", "value": 0, "errors": ["below_minimum"]},
    {"input": "requestLimit", "value": 257, "errors": ["above_maximum"]},
    {"input": "requestLimit", "value": "16", "errors": ["wrong_type"]}
  ]
}
