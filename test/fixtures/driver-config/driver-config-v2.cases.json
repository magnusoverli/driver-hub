{
  "schema": "driver-config",
  "description": "schemaVersion 2 (proposed) declarations. Each case applies a JSON Merge Patch (RFC 7386) to base; arrays replace the base array. Invalid cases name the JSON Pointer where an error must be reported. Value rules are in driver-config-values.cases.json. Run: python3 tools/validate-driver.py fixtures",
  "base": {
    "schemaVersion": 2,
    "inputs": [
      {"name": "backendUrl", "type": "string", "required": true, "env": "BACKEND_URL", "url": {"schemes": ["wss"], "path": "/x-driver/v1", "allowCredentials": false, "allowQuery": false, "allowFragment": false}},
      {"name": "logLevel", "type": "string", "required": false, "default": "info", "env": "LOG_LEVEL", "enum": ["trace", "debug", "info", "warn", "error"]}
    ]
  },
  "cases": [
    {"rule": "schemaVersion", "valid": true, "note": "base document"},
    {"rule": "schemaVersion", "valid": true, "note": "v1 declarations stay valid", "patch": {"schemaVersion": 1, "inputs": [{"name": "host", "type": "string", "required": true, "env": "HOST"}]}},
    {"rule": "schemaVersion", "valid": false, "at": "/inputs/0", "note": "v1 refuses url and enum", "patch": {"schemaVersion": 1}},
    {"rule": "schemaVersion", "valid": false, "at": "/schemaVersion", "note": "unknown version", "patch": {"schemaVersion": 3}},
    {"rule": "schemaVersion", "valid": false, "at": "/schemaVersion", "note": "a string is not a version", "patch": {"schemaVersion": "2"}},

    {"rule": "v1 rules apply", "valid": true, "patch": {"inputs": [{"name": "backendUrl", "type": "string", "required": true, "env": "BACKEND_URL", "url": {"schemes": ["wss"], "path": "/x-driver/v1", "allowCredentials": false, "allowQuery": false, "allowFragment": false}}, {"name": "logLevel", "type": "string", "required": false, "default": "info", "env": "LOG_LEVEL", "enum": ["trace", "debug", "info", "warn", "error"]}, {"name": "devicePort", "type": "integer", "required": false, "default": 443, "minimum": 1, "maximum": 65535, "env": "DEVICE_PORT"}]}},
    {"rule": "v1 rules apply", "valid": false, "at": "/", "note": "unknown top-level key", "patch": {"label": "x"}},
    {"rule": "v1 rules apply", "valid": false, "at": "/inputs/1/name", "note": "duplicate names", "patch": {"inputs": [{"name": "backendUrl", "type": "string", "required": true, "env": "BACKEND_URL", "url": {"schemes": ["wss"], "path": "/x-driver/v1", "allowCredentials": false, "allowQuery": false, "allowFragment": false}}, {"name": "backendUrl", "type": "string", "required": false, "default": "info", "env": "LOG_LEVEL", "enum": ["trace", "debug", "info", "warn", "error"]}]}},
    {"rule": "v1 rules apply", "valid": false, "at": "/inputs/1", "note": "misspelled input key", "patch": {"inputs": [{"name": "backendUrl", "type": "string", "required": true, "env": "BACKEND_URL", "url": {"schemes": ["wss"], "path": "/x-driver/v1", "allowCredentials": false, "allowQuery": false, "allowFragment": false}}, {"name": "logLevel", "type": "string", "required": false, "default": "info", "env": "LOG_LEVEL", "enums": ["trace", "debug", "info", "warn", "error"]}]}},

    {"rule": "url keys", "valid": true, "note": "no path: any path is accepted", "patch": {"inputs": [{"name": "backendUrl", "type": "string", "required": true, "env": "BACKEND_URL", "url": {"schemes": ["wss"], "allowCredentials": false, "allowQuery": false, "allowFragment": false}}]}},
    {"rule": "url keys", "valid": false, "at": "/inputs/0/url", "note": "misspelled key", "patch": {"inputs": [{"name": "backendUrl", "type": "string", "required": true, "env": "BACKEND_URL", "url": {"shemes": ["wss"], "allowCredentials": false, "allowQuery": false, "allowFragment": false}}]}},
    {"rule": "url keys", "valid": false, "at": "/inputs/0/url", "note": "allowQuery is required: no implied default", "patch": {"inputs": [{"name": "backendUrl", "type": "string", "required": true, "env": "BACKEND_URL", "url": {"schemes": ["wss"], "path": "/x-driver/v1", "allowCredentials": false, "allowFragment": false}}]}},
    {"rule": "url keys", "valid": false, "at": "/inputs/0/url", "note": "allowCredentials is required", "patch": {"inputs": [{"name": "backendUrl", "type": "string", "required": true, "env": "BACKEND_URL", "url": {"schemes": ["wss"], "path": "/x-driver/v1", "allowQuery": false, "allowFragment": false}}]}},
    {"rule": "url keys", "valid": false, "at": "/inputs/0/url", "note": "allowFragment is required", "patch": {"inputs": [{"name": "backendUrl", "type": "string", "required": true, "env": "BACKEND_URL", "url": {"schemes": ["wss"], "path": "/x-driver/v1", "allowCredentials": false, "allowQuery": false}}]}},
    {"rule": "url keys", "valid": false, "at": "/inputs/0/url/allowQuery", "patch": {"inputs": [{"name": "backendUrl", "type": "string", "required": true, "env": "BACKEND_URL", "url": {"schemes": ["wss"], "path": "/x-driver/v1", "allowCredentials": false, "allowQuery": "no", "allowFragment": false}}]}},
    {"rule": "url keys", "valid": false, "at": "/inputs/0/url", "note": "unknown key", "patch": {"inputs": [{"name": "backendUrl", "type": "string", "required": true, "env": "BACKEND_URL", "url": {"schemes": ["wss"], "path": "/x-driver/v1", "allowCredentials": false, "allowQuery": false, "allowFragment": false, "hosts": ["vip.example.test"]}}]}},
    {"rule": "url keys", "valid": false, "at": "/inputs/0/url", "note": "must be an object", "patch": {"inputs": [{"name": "backendUrl", "type": "string", "required": true, "env": "BACKEND_URL", "url": "wss"}]}},

    {"rule": "url schemes", "valid": true, "note": "dual-scheme", "patch": {"inputs": [{"name": "backendUrl", "type": "string", "required": true, "env": "BACKEND_URL", "url": {"schemes": ["ws", "wss"], "path": "/x-driver/v1", "allowCredentials": false, "allowQuery": false, "allowFragment": false}}]}},
    {"rule": "url schemes", "valid": true, "note": "every scheme character", "patch": {"inputs": [{"name": "backendUrl", "type": "string", "required": true, "env": "BACKEND_URL", "url": {"schemes": ["coap+tcp", "x.y-z"], "path": "/x-driver/v1", "allowCredentials": false, "allowQuery": false, "allowFragment": false}}]}},
    {"rule": "url schemes", "valid": false, "at": "/inputs/0/url/schemes", "note": "empty", "patch": {"inputs": [{"name": "backendUrl", "type": "string", "required": true, "env": "BACKEND_URL", "url": {"schemes": [], "path": "/x-driver/v1", "allowCredentials": false, "allowQuery": false, "allowFragment": false}}]}},
    {"rule": "url schemes", "valid": false, "at": "/inputs/0/url", "note": "required", "patch": {"inputs": [{"name": "backendUrl", "type": "string", "required": true, "env": "BACKEND_URL", "url": {"path": "/x-driver/v1", "allowCredentials": false, "allowQuery": false, "allowFragment": false}}]}},
    {"rule": "url schemes", "valid": false, "at": "/inputs/0/url/schemes", "note": "duplicates", "patch": {"inputs": [{"name": "backendUrl", "type": "string", "required": true, "env": "BACKEND_URL", "url": {"schemes": ["wss", "wss"], "path": "/x-driver/v1", "allowCredentials": false, "allowQuery": false, "allowFragment": false}}]}},
    {"rule": "url schemes", "valid": false, "at": "/inputs/0/url/schemes/0", "note": "declare lowercase", "patch": {"inputs": [{"name": "backendUrl", "type": "string", "required": true, "env": "BACKEND_URL", "url": {"schemes": ["WSS"], "path": "/x-driver/v1", "allowCredentials": false, "allowQuery": false, "allowFragment": false}}]}},
    {"rule": "url schemes", "valid": false, "at": "/inputs/0/url/schemes/0", "note": "no delimiter", "patch": {"inputs": [{"name": "backendUrl", "type": "string", "required": true, "env": "BACKEND_URL", "url": {"schemes": ["wss:"], "path": "/x-driver/v1", "allowCredentials": false, "allowQuery": false, "allowFragment": false}}]}},
    {"rule": "url schemes", "valid": false, "at": "/inputs/0/url/schemes/0", "patch": {"inputs": [{"name": "backendUrl", "type": "string", "required": true, "env": "BACKEND_URL", "url": {"schemes": ["1ws"], "path": "/x-driver/v1", "allowCredentials": false, "allowQuery": false, "allowFragment": false}}]}},
    {"rule": "url schemes", "valid": false, "at": "/inputs/0/url/schemes", "note": "a list", "patch": {"inputs": [{"name": "backendUrl", "type": "string", "required": true, "env": "BACKEND_URL", "url": {"schemes": "wss", "path": "/x-driver/v1", "allowCredentials": false, "allowQuery": false, "allowFragment": false}}]}},

    {"rule": "url path", "valid": true, "patch": {"inputs": [{"name": "backendUrl", "type": "string", "required": true, "env": "BACKEND_URL", "url": {"schemes": ["wss"], "path": "/", "allowCredentials": false, "allowQuery": false, "allowFragment": false}}]}},
    {"rule": "url path", "valid": true, "note": "every allowed character, uppercase escape", "patch": {"inputs": [{"name": "backendUrl", "type": "string", "required": true, "env": "BACKEND_URL", "url": {"schemes": ["wss"], "path": "/api/v1;a=b/%2F@:x~!$&'()*+,", "allowCredentials": false, "allowQuery": false, "allowFragment": false}}]}},
    {"rule": "url path", "valid": true, "note": "dots inside a segment are not dot segments", "patch": {"inputs": [{"name": "backendUrl", "type": "string", "required": true, "env": "BACKEND_URL", "url": {"schemes": ["wss"], "path": "/a/.well-known/..x", "allowCredentials": false, "allowQuery": false, "allowFragment": false}}]}},
    {"rule": "url path", "valid": false, "at": "/inputs/0/url/path", "note": "relative", "patch": {"inputs": [{"name": "backendUrl", "type": "string", "required": true, "env": "BACKEND_URL", "url": {"schemes": ["wss"], "path": "x-driver/v1", "allowCredentials": false, "allowQuery": false, "allowFragment": false}}]}},
    {"rule": "url path", "valid": false, "at": "/inputs/0/url/path", "note": "empty", "patch": {"inputs": [{"name": "backendUrl", "type": "string", "required": true, "env": "BACKEND_URL", "url": {"schemes": ["wss"], "path": "", "allowCredentials": false, "allowQuery": false, "allowFragment": false}}]}},
    {"rule": "url path", "valid": false, "at": "/inputs/0/url/path", "note": "dot segment", "patch": {"inputs": [{"name": "backendUrl", "type": "string", "required": true, "env": "BACKEND_URL", "url": {"schemes": ["wss"], "path": "/x-driver/./v1", "allowCredentials": false, "allowQuery": false, "allowFragment": false}}]}},
    {"rule": "url path", "valid": false, "at": "/inputs/0/url/path", "note": "trailing dot-dot segment", "patch": {"inputs": [{"name": "backendUrl", "type": "string", "required": true, "env": "BACKEND_URL", "url": {"schemes": ["wss"], "path": "/x-driver/..", "allowCredentials": false, "allowQuery": false, "allowFragment": false}}]}},
    {"rule": "url path", "valid": false, "at": "/inputs/0/url/path", "note": "encoded dot segment", "patch": {"inputs": [{"name": "backendUrl", "type": "string", "required": true, "env": "BACKEND_URL", "url": {"schemes": ["wss"], "path": "/x-driver/%2e/v1", "allowCredentials": false, "allowQuery": false, "allowFragment": false}}]}},
    {"rule": "url path", "valid": false, "at": "/inputs/0/url/path", "note": "mixed encoded dot-dot segment", "patch": {"inputs": [{"name": "backendUrl", "type": "string", "required": true, "env": "BACKEND_URL", "url": {"schemes": ["wss"], "path": "/x-driver/.%2E/v1", "allowCredentials": false, "allowQuery": false, "allowFragment": false}}]}},
    {"rule": "url path", "valid": false, "at": "/inputs/0/url/path", "note": "lowercase hex escape", "patch": {"inputs": [{"name": "backendUrl", "type": "string", "required": true, "env": "BACKEND_URL", "url": {"schemes": ["wss"], "path": "/a%2f", "allowCredentials": false, "allowQuery": false, "allowFragment": false}}]}},
    {"rule": "url path", "valid": false, "at": "/inputs/0/url/path", "note": "incomplete escape", "patch": {"inputs": [{"name": "backendUrl", "type": "string", "required": true, "env": "BACKEND_URL", "url": {"schemes": ["wss"], "path": "/a%", "allowCredentials": false, "allowQuery": false, "allowFragment": false}}]}},
    {"rule": "url path", "valid": false, "at": "/inputs/0/url/path", "note": "query", "patch": {"inputs": [{"name": "backendUrl", "type": "string", "required": true, "env": "BACKEND_URL", "url": {"schemes": ["wss"], "path": "/a?b", "allowCredentials": false, "allowQuery": false, "allowFragment": false}}]}},
    {"rule": "url path", "valid": false, "at": "/inputs/0/url/path", "note": "fragment", "patch": {"inputs": [{"name": "backendUrl", "type": "string", "required": true, "env": "BACKEND_URL", "url": {"schemes": ["wss"], "path": "/a#b", "allowCredentials": false, "allowQuery": false, "allowFragment": false}}]}},
    {"rule": "url path", "valid": false, "at": "/inputs/0/url/path", "note": "space", "patch": {"inputs": [{"name": "backendUrl", "type": "string", "required": true, "env": "BACKEND_URL", "url": {"schemes": ["wss"], "path": "/a b", "allowCredentials": false, "allowQuery": false, "allowFragment": false}}]}},

    {"rule": "url inputs", "valid": true, "note": "two URL inputs, different policies", "patch": {"inputs": [{"name": "backendUrl", "type": "string", "required": true, "env": "BACKEND_URL", "url": {"schemes": ["wss"], "path": "/x-driver/v1", "allowCredentials": false, "allowQuery": false, "allowFragment": false}}, {"name": "deviceUrl", "type": "string", "required": true, "env": "DEVICE_URL", "url": {"schemes": ["http"], "allowCredentials": false, "allowQuery": true, "allowFragment": false}}]}},
    {"rule": "url inputs", "valid": false, "at": "/inputs/0/url", "note": "strings only", "patch": {"inputs": [{"name": "port", "type": "integer", "required": true, "env": "PORT", "url": {"schemes": ["wss"], "path": "/x-driver/v1", "allowCredentials": false, "allowQuery": false, "allowFragment": false}}]}},
    {"rule": "url inputs", "valid": false, "at": "/inputs/0/url", "note": "strings only", "patch": {"inputs": [{"name": "on", "type": "boolean", "required": true, "env": "ON", "url": {"schemes": ["wss"], "path": "/x-driver/v1", "allowCredentials": false, "allowQuery": false, "allowFragment": false}}]}},
    {"rule": "url inputs", "valid": false, "at": "/inputs/0/url", "note": "not on secrets", "patch": {"inputs": [{"name": "backendUrl", "type": "string", "required": true, "env": "BACKEND_URL", "url": {"schemes": ["wss"], "path": "/x-driver/v1", "allowCredentials": false, "allowQuery": false, "allowFragment": false}, "secret": true}]}},

    {"rule": "enum", "valid": true, "note": "one choice", "patch": {"inputs": [{"name": "logLevel", "type": "string", "required": false, "default": "only", "env": "LOG_LEVEL", "enum": ["only"]}]}},
    {"rule": "enum", "valid": true, "note": "case-sensitive, any characters", "patch": {"inputs": [{"name": "logLevel", "type": "string", "required": false, "default": "A", "env": "LOG_LEVEL", "enum": ["a", "A", "ä"]}]}},
    {"rule": "enum", "valid": false, "at": "/inputs/0/enum", "note": "empty", "patch": {"inputs": [{"name": "logLevel", "type": "string", "required": false, "env": "LOG_LEVEL", "enum": []}]}},
    {"rule": "enum", "valid": false, "at": "/inputs/0/enum", "note": "duplicates", "patch": {"inputs": [{"name": "logLevel", "type": "string", "required": false, "default": "info", "env": "LOG_LEVEL", "enum": ["info", "info"]}]}},
    {"rule": "enum", "valid": false, "at": "/inputs/0/enum/0", "note": "empty choice", "patch": {"inputs": [{"name": "logLevel", "type": "string", "required": false, "default": "info", "env": "LOG_LEVEL", "enum": ["", "info"]}]}},
    {"rule": "enum", "valid": false, "at": "/inputs/0/enum/0", "note": "string choices", "patch": {"inputs": [{"name": "logLevel", "type": "string", "required": false, "default": "info", "env": "LOG_LEVEL", "enum": [1, "info"]}]}},
    {"rule": "enum", "valid": false, "at": "/inputs/0/enum", "note": "a list", "patch": {"inputs": [{"name": "logLevel", "type": "string", "required": false, "default": "info", "env": "LOG_LEVEL", "enum": "info"}]}},
    {"rule": "enum", "valid": false, "at": "/inputs/0/enum", "note": "strings only", "patch": {"inputs": [{"name": "port", "type": "integer", "required": true, "env": "PORT", "enum": ["1"]}]}},
    {"rule": "enum", "valid": false, "at": "/inputs/0/enum", "note": "strings only", "patch": {"inputs": [{"name": "on", "type": "boolean", "required": true, "env": "ON", "enum": ["true"]}]}},
    {"rule": "enum", "valid": false, "at": "/inputs/0/enum", "note": "not on secrets", "patch": {"inputs": [{"name": "logLevel", "type": "string", "required": false, "env": "LOG_LEVEL", "enum": ["trace", "debug", "info", "warn", "error"], "secret": true}]}},

    {"rule": "enum or url", "valid": true, "note": "base declares each on its own input"},
    {"rule": "enum or url", "valid": false, "at": "/inputs/0", "note": "not both on one input", "patch": {"inputs": [{"name": "backendUrl", "type": "string", "required": true, "env": "BACKEND_URL", "url": {"schemes": ["wss"], "path": "/x-driver/v1", "allowCredentials": false, "allowQuery": false, "allowFragment": false}, "enum": ["wss://vip.example.test/x-driver/v1"]}]}},

    {"rule": "enum choices within bounds", "valid": true, "patch": {"inputs": [{"name": "logLevel", "type": "string", "required": false, "default": "info", "env": "LOG_LEVEL", "enum": ["trace", "debug", "info", "warn", "error"], "minLength": 4, "maxLength": 5}]}},
    {"rule": "enum choices within bounds", "valid": false, "at": "/inputs/0/enum/2", "note": "info is shorter than minLength", "patch": {"inputs": [{"name": "logLevel", "type": "string", "required": false, "default": "info", "env": "LOG_LEVEL", "enum": ["trace", "debug", "info", "warn", "error"], "minLength": 5}]}},
    {"rule": "enum choices within bounds", "valid": false, "at": "/inputs/0/enum/0", "note": "trace is longer than maxLength", "patch": {"inputs": [{"name": "logLevel", "type": "string", "required": false, "default": "info", "env": "LOG_LEVEL", "enum": ["trace", "debug", "info", "warn", "error"], "maxLength": 4}]}},

    {"rule": "default in enum", "valid": true, "patch": {"inputs": [{"name": "logLevel", "type": "string", "required": false, "default": "error", "env": "LOG_LEVEL", "enum": ["trace", "debug", "info", "warn", "error"]}]}},
    {"rule": "default in enum", "valid": true, "note": "no default", "patch": {"inputs": [{"name": "logLevel", "type": "string", "required": false, "env": "LOG_LEVEL", "enum": ["trace", "debug", "info", "warn", "error"]}]}},
    {"rule": "default in enum", "valid": false, "at": "/inputs/0/default", "note": "case-sensitive", "patch": {"inputs": [{"name": "logLevel", "type": "string", "required": false, "default": "INFO", "env": "LOG_LEVEL", "enum": ["trace", "debug", "info", "warn", "error"]}]}},
    {"rule": "default in enum", "valid": false, "at": "/inputs/0/default", "patch": {"inputs": [{"name": "logLevel", "type": "string", "required": false, "default": "verbose", "env": "LOG_LEVEL", "enum": ["trace", "debug", "info", "warn", "error"]}]}},
    {"rule": "default in enum", "valid": false, "at": "/inputs/0/default", "patch": {"inputs": [{"name": "logLevel", "type": "string", "required": false, "default": "", "env": "LOG_LEVEL", "enum": ["trace", "debug", "info", "warn", "error"]}]}},

    {"rule": "default satisfies url", "valid": true, "patch": {"inputs": [{"name": "backendUrl", "type": "string", "required": false, "env": "BACKEND_URL", "url": {"schemes": ["wss"], "path": "/x-driver/v1", "allowCredentials": false, "allowQuery": false, "allowFragment": false}, "default": "wss://vip.example.test/x-driver/v1"}]}},
    {"rule": "default satisfies url", "valid": false, "at": "/inputs/0/default", "note": "scheme", "patch": {"inputs": [{"name": "backendUrl", "type": "string", "required": false, "env": "BACKEND_URL", "url": {"schemes": ["wss"], "path": "/x-driver/v1", "allowCredentials": false, "allowQuery": false, "allowFragment": false}, "default": "ws://vip.example.test/x-driver/v1"}]}},
    {"rule": "default satisfies url", "valid": false, "at": "/inputs/0/default", "note": "query", "patch": {"inputs": [{"name": "backendUrl", "type": "string", "required": false, "env": "BACKEND_URL", "url": {"schemes": ["wss"], "path": "/x-driver/v1", "allowCredentials": false, "allowQuery": false, "allowFragment": false}, "default": "wss://vip.example.test/x-driver/v1?node_id=1"}]}},
    {"rule": "default satisfies url", "valid": false, "at": "/inputs/0/default", "note": "not a URL", "patch": {"inputs": [{"name": "backendUrl", "type": "string", "required": false, "env": "BACKEND_URL", "url": {"schemes": ["wss"], "path": "/x-driver/v1", "allowCredentials": false, "allowQuery": false, "allowFragment": false}, "default": ""}]}}
  ]
}
